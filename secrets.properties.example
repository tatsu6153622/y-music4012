# Copy to secrets.properties (gitignored); ./encrypt.sh seals it with signing/ into secrets.enc.
# Every key is optional: leave one out and that feature is off. Where a key notes an Env:, that
# environment variable takes precedence over it.
#
# Per-machine settings stay in local.properties, which is never sealed and wins over this file:
# sdk.dir (Android Studio writes it), and local.server.ip / local.server.port (default 8787) for
# a dev server on this machine, used instead of remote.config.url with -PuseLocalServerIp.

# --- YMusic service (ymusic-server) ---
# Base url of the service. Unset: the app makes no service request — no remote config, app updates,
# SponsorBlock skips or QR sign-in. Env: YMUSIC_REMOTE_CONFIG_URL
remote.config.url=https://api.example.com
# Public key (base64 SPKI, ECDSA P-256) verifying JS bundles the service offers. Unset: only the
# bundled JS runs. Env: YMUSIC_BUNDLE_PUBLIC_KEY
bundle.signing.public.key=
# Public key (base64 SPKI, ECDSA P-256) verifying app updates. Unset: no update is offered.
# Env: YMUSIC_UPDATE_PUBLIC_KEY
update.public.key=

# --- Android release signing ---
# Keystore (path from the repo root), its password, and the key alias. keyPassword defaults to the
# store password (PKCS12). Unset: release builds are debug-signed — fine to test, never to ship.
# Env: YMUSIC_ANDROID_STORE_FILE, YMUSIC_ANDROID_STORE_PASSWORD, YMUSIC_ANDROID_KEY_ALIAS,
# YMUSIC_ANDROID_KEY_PASSWORD
android.signing.storeFile=signing/release.p12
android.signing.storePassword=
android.signing.keyAlias=ymusic

# --- Sentry crash reporting ---
# Project DSN. Unset: the SDK stays off. Env: SENTRY_DSN
sentry.dsn=
# Org auth token for uploading release mapping files. Unset: no upload. Env: SENTRY_AUTH_TOKEN
sentry.auth.token=

# --- macOS release signing (desktop packaging only) ---
# Developer ID Application identity. Unset: builds are unsigned. Env: YMUSIC_MAC_IDENTITY
mac.signing.identity=
# Notarization: Apple ID, its app-specific password (not the account password) and team ID.
# Env: YMUSIC_MAC_APPLE_ID, YMUSIC_MAC_APPLE_PASSWORD, YMUSIC_MAC_TEAM_ID
mac.notarization.appleId=
mac.notarization.password=
mac.notarization.teamId=
