<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_play"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/notification_play">

    <ImageView
        android:id="@+id/widget_play_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_play_circle" />

    <ImageView
        android:id="@+id/widget_play_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/media3_icon_play"
        android:tint="#FF1B1B1B" />
</FrameLayout>
