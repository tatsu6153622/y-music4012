package = io.ymusic.quickjs.cinterop
headers = quickjs_native.h
headerFilter = quickjs_native.h
# Embed the QuickJS core static lib INTO the klib (konan copies it to `included/`), so it propagates
# to consumers with no linkerOpts on their side. The per-target `libraryPath` is supplied by the
# build script's cinterop extraOpts (it differs per Konan target).
staticLibraries = libqjscore.a
