-- The sealed cookie jar and the OS key material it is sealed with, one blob per name.
CREATE TABLE secret (
    name  TEXT NOT NULL PRIMARY KEY,
    value BLOB NOT NULL
);

select:
SELECT value FROM secret WHERE name = ?;

put:
INSERT OR REPLACE INTO secret(name, value) VALUES (?, ?);

putIfAbsent:
INSERT OR IGNORE INTO secret(name, value) VALUES (?, ?);

delete:
DELETE FROM secret WHERE name = ?;
